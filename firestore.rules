rules_version = '2';

// Access rules for the interest list behind the sign-in button.
//
// This collection holds personal data, so the posture is deny-by-default and
// every allowance below is written out rather than inherited. Two decisions do
// most of the work:
//
//   * `get` is granted, `list` never is. A signed-in visitor can read back their
//     own document, but the collection cannot be queried, so holding one valid
//     account does not let anyone enumerate everyone else. This is the failure
//     mode that leaks address lists, and it is worth being explicit about.
//
//   * The document id IS the caller's uid, which makes `uid == request.auth.uid`
//     the entire authorisation check. There is no addressable path to another
//     person's document, so there is nothing to get subtly wrong later.
//
// Records are write-once, and self-delete-only: no update, ever, from any
// caller. A signed-in visitor CAN remove their own record — see ADR-0013 in
// radiator-engineering/radiator, ["Removal is a request, except from the
// session that wrote it"](https://github.com/radiator-engineering/radiator/blob/main/docs/adr/0013-removal-is-a-request-except-from-the-session-that-wrote-it.md)
// — but cannot rewrite it, and cannot touch anyone else's.
//
// NOTE ON DEPLOYMENT: this repo has no firebase.json, no .firebaserc and no CI
// step that pushes this file anywhere. Merging a change here updates the
// tracked source; it does NOT change what Firestore enforces until an
// operator runs `firebase deploy --only firestore:rules --project
// radiator-signups` (or the console equivalent) by hand.

service cloud.firestore {
  match /databases/{database}/documents {

    match /signups/{uid} {

      allow get: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    // Keep only what identifies an interested person. Matching
                    // the key set exactly stops a client from quietly attaching
                    // extra fields to a document we then have to store forever.
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'createdAt'])
                    && request.resource.data.uid == uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 320
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200
                    // The server's clock, not the caller's, so the timestamp is
                    // worth something. The client must send a server timestamp.
                    && request.resource.data.createdAt == request.time;

      // `list` and `update` are spelled out rather than left to inherit deny,
      // so widening either later is a deliberate edit, not an accident of
      // omission. `delete` is the one exception, and it uses the exact same
      // check `get` above already does: the record's own owner may remove it,
      // nobody else may touch it, and the collection still cannot be queried
      // to find out who else is on it.
      allow list, update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything not named above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
